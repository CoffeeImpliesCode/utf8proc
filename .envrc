#
# direnv entry: devenv is the canonical shell for this SDK. No host path, mount
# or account is written here. TMPDIR, XDG_RUNTIME_DIR, DEVENV_HOME and both Zig
# caches are supplied by the caller and are left exactly as they arrive.

if ! declare -F use >/dev/null 2>&1; then
  echo ".envrc: direnv is not on PATH; run 'devenv shell' instead." >&2
  return 1
fi

# devenv defaults its runtime sockets to /tmp even when TMPDIR is set, so the
# socket base is the one variable this file supplies when the caller named an
# approved scratch root.
if [ -n "${HOST_SCRATCH_ROOT:-}" ] && [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="${HOST_SCRATCH_ROOT}/run"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

use devenv